[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = false

[libraries]

linux.debug.x86_64 =     "res://../rust/target/debug/libmathtrees_rust.so"
linux.release.x86_64 =   "res://../rust/target/release/libmathtrees_rust.so"

windows.debug.x86_64 =   "res://../rust/target/debug/mathtrees_rust.dll"
windows.release.x86_64 = "res://../rust/target/release/mathtrees_rust.dll"

android.debug.arm64 =      "res://../rust/android/arm64-v8a/libmathtrees_rust.so"
android.release.arm64 =    "res://../rust/android/arm64-v8a/libmathtrees_rust.so"